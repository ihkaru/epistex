#!/usr/bin/env python3
"""Main executable entrypoint for kb CLI tool."""

import os
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from config.app import APP_DESCRIPTION, APP_VERSION, EX_OK, EX_SOFTWARE
from src.commands.base_command import AgentArgumentParser, add_common_flags, output_result
from src.commands.cmd_init import run_init
from src.commands.cmd_doctor import run_doctor
from src.commands.cmd_map import run_map
from src.commands.cmd_create import run_create
from src.commands.cmd_schedule import run_schedule
from src.commands.cmd_run import run_code
from src.commands.cmd_secrets import run_secrets
from src.commands.cmd_asset import (
    run_asset_push,
    run_asset_pull,
    run_asset_check,
    run_asset_list,
)
from src.core.errors import KBError
from src.events.dispatcher import get_event_dispatcher
from src.listeners.audit_listener import AuditEventListener
from src.listeners.telemetry_listener import TelemetryEventListener


def _add_asset_subparsers(subparsers) -> None:
    """Register asset push, pull, check, and list subcommands."""
    asset_p = subparsers.add_parser("asset", help="Manage cloud-offloaded binary assets and companion markdown")
    add_common_flags(asset_p)
    asset_subs = asset_p.add_subparsers(dest="asset_action", required=True)

    push_p = asset_subs.add_parser("push", help="Upload binary asset to storage and generate companion markdown")
    add_common_flags(push_p)
    push_p.add_argument("file", help="Local binary asset file path")
    push_p.add_argument("--key", help="Remote storage object key")
    push_p.add_argument("--companion", help="Companion markdown path under knowledge/")
    push_p.add_argument("--title", help="Document title for companion")
    push_p.add_argument("--owner", help="Document owner handle")
    push_p.add_argument("--backend", help="Storage backend (local, s3)")
    push_p.add_argument("--cloud-auth", choices=["env", "hermetic", "auto"], help="Cloud credentials source")

    pull_p = asset_subs.add_parser("pull", help="Download asset from storage on-demand")
    add_common_flags(pull_p)
    pull_p.add_argument("key", help="Remote storage object key to fetch")
    pull_p.add_argument("--target", help="Destination file path")
    pull_p.add_argument("--backend", help="Storage backend (local, s3)")
    pull_p.add_argument("--cloud-auth", choices=["env", "hermetic", "auto"], help="Cloud credentials source")

    check_p = asset_subs.add_parser("check", help="Check remote asset existence without downloading blob")
    add_common_flags(check_p)
    check_p.add_argument("key", help="Remote storage object key to check")
    check_p.add_argument("--backend", help="Storage backend (local, s3)")
    check_p.add_argument("--cloud-auth", choices=["env", "hermetic", "auto"], help="Cloud credentials source")

    list_p = asset_subs.add_parser("list", help="Discover companion assets across local and cloud tiers")
    add_common_flags(list_p)
    list_p.add_argument("--tier", choices=["local", "cloud", "all"], default="local", help="Discovery tier")
    list_p.add_argument("--backend", help="Storage backend (local, s3)")
    list_p.add_argument("--cloud-auth", choices=["env", "hermetic", "auto"], help="Cloud credentials source")


def _add_core_subparsers(subparsers) -> None:
    """Register core discovery, creation, and execution subcommands."""
    init_p = subparsers.add_parser("init", help="Initialize and specialize repository for an organization")
    add_common_flags(init_p)
    init_p.add_argument("--name", help="Organization or project name")
    init_p.add_argument("--description", help="Project description")
    init_p.add_argument("--owner", help="Default owner handle (e.g. @team)")
    init_p.add_argument("--clean-samples", action="store_true", help="Remove starter sample documents")
    init_p.add_argument("--keep-notice", action="store_true", help="Keep specialization notice in README")

    doc_p = subparsers.add_parser("doctor", help="Audit schema, dead links, line limits, and secret leaks")
    add_common_flags(doc_p)
    doc_p.add_argument("--check-assets", action="store_true", help="Audit cloud assets existence in companions")
    doc_p.add_argument("--cloud-auth", choices=["env", "hermetic", "auto"], help="Cloud credentials source")

    map_p = subparsers.add_parser("map", help="Display token-budget bounded repository tree")
    add_common_flags(map_p)
    map_p.add_argument("--depth", type=int, default=2, help="Maximum traversal depth (default: 2)")
    map_p.add_argument("--with-assets", action="store_true", help="Include asset companion metadata in map tree")

    create_p = subparsers.add_parser("create", help="Scaffold new document from template")
    add_common_flags(create_p)
    create_p.add_argument("template", help="Template type (adr, runbook, activity, companion)")
    create_p.add_argument("path", help="Relative destination path under knowledge/")
    create_p.add_argument("--title", help="Document title")
    create_p.add_argument("--owner", help="Owner handle or team name")
    create_p.add_argument("--force", action="store_true", help="Overwrite existing document")


def _build_parser() -> AgentArgumentParser:
    """Build root CLI argument parser and register subcommands."""
    prog_name = Path(sys.argv[0]).name if sys.argv and sys.argv[0] else "gnosidex"
    parser = AgentArgumentParser(prog=prog_name, description=f"{APP_DESCRIPTION} (v{APP_VERSION})")
    parser.add_argument("--version", action="version", version=f"gnosidex (kb) {APP_VERSION}")
    add_common_flags(parser)

    subparsers = parser.add_subparsers(dest="subcommand", required=True)
    _add_core_subparsers(subparsers)

    sched_p = subparsers.add_parser("schedule", help="Query upcoming deadlines using bounded min-heap")
    add_common_flags(sched_p)
    sched_p.add_argument("--limit", type=int, default=10, help="Max deadlines to return (default: 10)")
    sched_p.add_argument("--category", help="Filter by document category")
    sched_p.add_argument("--all", action="store_true", help="Include archived/completed documents")

    run_p = subparsers.add_parser("run", help="Hermetically execute command with runtime secret injection")
    add_common_flags(run_p)
    run_p.add_argument("--timeout", type=float, default=60.0, help="Command timeout in seconds")
    run_p.add_argument("--vault", help="Secret provider backend (infisical, env, memory, auto)")
    run_p.add_argument("--cwd", help="Working directory for command")
    run_p.add_argument("cmd", nargs="+", help="Command and arguments to execute")

    sec_p = subparsers.add_parser("secrets", help="Inspect active secret provider and available keys")
    add_common_flags(sec_p)
    sec_p.add_argument("--vault", help="Secret provider backend to inspect")

    _add_asset_subparsers(subparsers)
    return parser


def _dispatch_asset_command(args, dispatcher, is_json: bool) -> int:
    """Route asset subcommands (push, pull, check, list)."""
    auth = getattr(args, "cloud_auth", None)
    if args.asset_action == "push":
        code, payload = run_asset_push(
            local_file=args.file,
            remote_key=args.key,
            companion_path=args.companion,
            title=args.title,
            owner=args.owner,
            backend=args.backend,
            cloud_auth=auth,
            dispatcher=dispatcher,
        )
    elif args.asset_action == "pull":
        code, payload = run_asset_pull(
            remote_key=args.key,
            target_path=args.target,
            backend=args.backend,
            cloud_auth=auth,
            dispatcher=dispatcher,
        )
    elif args.asset_action == "check":
        code, payload = run_asset_check(
            remote_key=args.key, backend=args.backend, cloud_auth=auth, dispatcher=dispatcher
        )
    else:  # list
        code, payload = run_asset_list(tier=args.tier, backend=args.backend, cloud_auth=auth)

    output_result(payload, is_json)
    return code


def _dispatch_admin_command(args, dispatcher, is_json: bool) -> Optional[int]:
    """Route admin/setup commands (init, doctor, map, create)."""
    if args.subcommand == "init":
        code, payload = run_init(
            name=args.name,
            description=args.description,
            owner=args.owner,
            clean_samples=args.clean_samples,
            clean_notice=not args.keep_notice,
            dry_run=args.dry_run,
            interactive=not (getattr(args, "non_interactive", False) or is_json),
            dispatcher=dispatcher,
        )
        output_result(payload, is_json)
        return code
    if args.subcommand == "doctor":
        code, payload = run_doctor(
            dispatcher=dispatcher,
            check_assets=args.check_assets,
            cloud_auth=getattr(args, "cloud_auth", None),
        )
        output_result(payload, is_json)
        return code
    if args.subcommand == "map":
        code, payload = run_map(depth=args.depth, compact=args.compact, with_assets=args.with_assets)
        output_result(payload, is_json)
        return code
    if args.subcommand == "create":
        code, payload = run_create(
            template_type=args.template,
            target_rel_path=args.path,
            title=args.title,
            owner=args.owner,
            force=args.force,
            dispatcher=dispatcher,
        )
        output_result(payload, is_json)
        return code
    return None


def _dispatch_command(args, dispatcher) -> int:
    """Route parsed subcommand to corresponding domain handler."""
    is_json = getattr(args, "json", False)
    admin_code = _dispatch_admin_command(args, dispatcher, is_json)
    if admin_code is not None:
        return admin_code

    if args.subcommand == "schedule":
        code, payload = run_schedule(limit=args.limit, category=args.category, active_only=not args.all)
        output_result(payload, is_json)
        return code
    if args.subcommand == "run":
        cwd_path = Path(args.cwd) if args.cwd else None
        code, payload = run_code(
            command=args.cmd,
            cwd=cwd_path,
            vault_backend=args.vault,
            timeout=args.timeout,
            dry_run=args.dry_run,
            dispatcher=dispatcher,
        )
        output_result(payload, is_json)
        return code
    if args.subcommand == "secrets":
        code, payload = run_secrets(vault_backend=args.vault)
        output_result(payload, is_json)
        return code
    if args.subcommand == "asset":
        return _dispatch_asset_command(args, dispatcher, is_json)

    return EX_OK


def main() -> None:
    """CLI bootstrap entrypoint."""
    dispatcher = get_event_dispatcher()
    dispatcher.subscribe("*", AuditEventListener().handle)
    dispatcher.subscribe("*", TelemetryEventListener(enabled=True).handle)

    parser = _build_parser()
    try:
        args = parser.parse_args()
        exit_code = _dispatch_command(args, dispatcher)
        sys.exit(exit_code)
    except KBError as err:
        output_result(err.to_envelope(), is_json="--json" in sys.argv or not sys.stdout.isatty())
        sys.exit(err.exit_code)
    except Exception as ex:
        err_envelope = {
            "status": "error",
            "exit_code": EX_SOFTWARE,
            "error_type": "UNCAUGHT_EXCEPTION",
            "message": str(ex),
        }
        output_result(err_envelope, is_json="--json" in sys.argv or not sys.stdout.isatty())
        sys.exit(EX_SOFTWARE)


if __name__ == "__main__":
    main()

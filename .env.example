# ==============================================================================
# Enterprise Git-Based Knowledge Base Starter Kit - Environment Variables
# ==============================================================================
# Copy this file to .env and adjust values for your organization:
#   cp .env.example .env
# ==============================================================================

# Application Metadata
KB_APP_NAME=kb
KB_APP_ENV=development

# Secret Management & Vault (Infisical)
# Supported backends: "infisical", "env", "auto" (default: "auto")
KB_VAULT_BACKEND=auto
INFISICAL_API_URL=https://app.infisical.com/api
INFISICAL_PROJECT_ID=your-project-id-here
INFISICAL_ENV=dev
INFISICAL_PATH=/
INFISICAL_CLIENT_ID=your-machine-identity-client-id
INFISICAL_CLIENT_SECRET=your-machine-identity-client-secret

# Cloud Storage & Asset Offloading (Opt-In)
# Supported backends: "local" (default offline zero-cost), "s3"
KB_CLOUD_STORAGE=local
KB_LOCAL_ASSET_DIR=storage/assets

# S3-Compatible Cloud Storage (AWS S3, MinIO, Cloudflare R2, Coolify S3, Ceph)
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET_NAME=your-organization-kb-assets
S3_REGION=us-east-1

# Cloud Authentication Mode: "env", "hermetic" (runtime vault injection), or "auto"
KB_CLOUD_AUTH=auto
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
